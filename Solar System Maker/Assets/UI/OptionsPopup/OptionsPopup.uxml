<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/OptionsPopup/OptionsPopupStyles.uss?fileID=7433441132597879392&amp;guid=2f3e8d53c4164944abcf95248b56c3fa&amp;type=3#OptionsPopupStyles" />
    <ui:VisualElement name="Outer" style="flex-grow: 1; height: 447px;">
        <ui:VisualElement name="Container" style="flex-grow: 1; height: 325px; max-height: 325px; min-height: 325px;">
            <ui:VisualElement name="Header" style="flex-grow: 1;">
                <ui:Button text="X" name="Close" class="close" />
                <ui:Label text="Simulation Options" name="Title" class="title" />
            </ui:VisualElement>
            <ui:VisualElement name="Content" style="flex-grow: 1;">
                <ui:Label text="&lt;b&gt;Your simulation is still running.&lt;/b&gt;&#10;You can change the simulation&apos;s details and settings here." name="Information" />
                <ui:VisualElement name="Fields" style="flex-grow: 1;">
                    <ui:TextField label="Name" placeholder-text="(blank)" name="Name" select-all-on-focus="false" select-all-on-mouse-up="false" style="color: rgb(255, 255, 255);" />
                    <ui:TextField label="Description" placeholder-text="(blank)" name="Description" select-all-on-focus="false" select-all-on-mouse-up="false" />
                    <ui:FloatField label="G" value="0" name="GravitationalConstant" placeholder-text="(blank)" />
                    <ui:DropdownField label="Collisions" name="CollisionQuality" choices="None,Low,High" />
                </ui:VisualElement>
                <ui:Label name="Validation" />
            </ui:VisualElement>
            <ui:VisualElement name="Footer" style="flex-grow: 1;">
                <ui:Button text="Reset" name="Reset" class="deleteButton" />
                <ui:Button text="Save" name="Save" class="loadButton" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

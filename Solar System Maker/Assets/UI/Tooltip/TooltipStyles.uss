#Tooltip {
    background-color: rgba(0, 0, 0, 0.49);
    position: absolute;
    height: 25px;
    max-height: 25px;
    min-height: 25px;
    justify-content: center;
    align-content: center;
    flex-shrink: 0;
    flex-grow: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    border-bottom-left-radius: 3px;
    left: 0;
    bottom: 0;
}

#Text {
    color: rgb(255, 255, 255);
    font-size: 12px;
    -unity-text-align: middle-left;
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

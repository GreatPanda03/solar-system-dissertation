<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/TutorialPopup/TutorialPopupStyles.uss?fileID=7433441132597879392&amp;guid=2f3e8d53c4164944abcf95248b56c3fa&amp;type=3#TutorialPopupStyles" />
    <ui:VisualElement name="Outer">
        <ui:VisualElement name="Container" style="flex-grow: 1; height: 325px; max-height: 325px; min-height: 325px;">
            <ui:VisualElement name="Header" style="flex-grow: 1;">
                <ui:Button text="X" name="Close" />
                <ui:Label text="Tutorial" name="Title" class="title" />
            </ui:VisualElement>
            <ui:ScrollView name="Scroller" horizontal-scroller-visibility="Hidden" style="height: 100%;">
                <ui:Label text="[page contents generated by tutorial handler]" name="Page" />
            </ui:ScrollView>
            <ui:VisualElement name="Footer" style="flex-grow: 1;">
                <ui:Button text="&lt;&lt;&lt;" name="Backwards" style="padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;" />
                <ui:Label text="Page x / y" name="PageNumber" style="width: 30%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;" />
                <ui:Button text="&gt;&gt;&gt;" name="Forwards" style="padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Simulator/SimulatorStyles.uss?fileID=7433441132597879392&amp;guid=f640695c10d59ba4199d931b7b100157&amp;type=3#SimulatorStyles" />
    <ui:VisualElement name="ToolBar" class="toolbar" style="flex-grow: 1; height: 30px; width: 100%; flex-direction: row; max-height: 30px; min-height: 30px; padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 0;">
        <ui:Button name="ExitSimulator" tooltip="Exit Simulation" class="toolboxButton">
            <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: resource(&apos;Icons/Toolbar/ExitSimulator&apos;);" />
        </ui:Button>
        <ui:Button name="SaveSimulation" tooltip="Save Simulation" class="toolboxButton">
            <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: resource(&apos;Icons/Toolbar/SaveSimulation&apos;);" />
        </ui:Button>
        <ui:Label text="Simulation Name" name="Title" class="title" style="width: auto; height: 100%; -unity-text-align: lower-left; margin-top: 5px; margin-right: 5px; margin-bottom: 5px; margin-left: 10px;" />
    </ui:VisualElement>
    <ui:VisualElement name="Properties" class="propertiesPanel" style="background-color: rgba(0, 0, 0, 0.59); top: 10px; left: auto; right: 10px;">
        <ui:Button text="X" name="Close" class="propertiesClose" style="position: absolute;" />
        <ui:Label text="Properties" name="Title" class="propertiesTitle" style="display: flex; align-self: center;" />
        <ui:VisualElement name="Groups" style="flex-grow: 1; display: flex;">
            <ui:GroupBox name="Body" class="propertiesGroup" style="display: flex;">
                <ui:Label text="Body" name="Title" class="propertiesTitle propertiesSubtitle" style="display: flex;" />
                <ui:TextField label="Name" placeholder-text="(blank)" name="Name" tooltip="Name" class="propertiesField" />
                <ui:FloatField label="Mass" value="10" name="Mass" tooltip="Mass" class="propertiesField" />
                <ui:FloatField label="Radius" value="10" name="Radius" tooltip="Radius" class="propertiesField" />
                <ui:FloatField label="Surface Temp." value="10" name="SurfaceTemp" tooltip="Surface Temperature" class="propertiesField" />
                <ui:FloatField label="Density" value="10" name="Density" tooltip="Density" class="propertiesField" />
            </ui:GroupBox>
            <ui:GroupBox name="Star" class="propertiesGroup" style="display: flex;">
                <ui:Label text="Star" name="Title" class="propertiesTitle propertiesSubtitle" style="display: flex;" />
                <ui:FloatField label="Luminosity" value="10" name="Luminosity" tooltip="Luminosity" class="propertiesField" />
            </ui:GroupBox>
            <ui:GroupBox name="Planet" class="propertiesGroup" style="display: flex;">
                <ui:Label text="Planet" name="Title" class="propertiesTitle propertiesSubtitle" style="display: flex;" />
                <ui:FloatField label="Water Content" value="10" name="WaterContent" tooltip="Water Content" class="propertiesField" />
                <ui:FloatField label="Habitability" value="10" name="Habitability" tooltip="Habitability" readonly="false" class="propertiesField" />
            </ui:GroupBox>
        </ui:VisualElement>
        <ui:Label text="Select a body in the system to see its properties" name="NoSelection" class="propertiesNoBody" style="display: none; margin-top: 5px; font-size: 12px;" />
    </ui:VisualElement>
    <ui:VisualElement name="Explorer" class="propertiesPanel" style="background-color: rgba(0, 0, 0, 0.59); top: auto; left: auto; right: 10px; bottom: 65px;">
        <ui:Button text="X" name="Close" class="propertiesClose" style="position: absolute;" />
        <ui:Label text="Explorer" name="Title" class="propertiesTitle" style="align-self: center;" />
        <ui:VisualElement name="Filters" style="flex-grow: 1;">
            <ui:VisualElement name="Search" style="flex-grow: 1; flex-direction: row; align-items: center; margin-top: 5px; margin-bottom: 5px;">
                <ui:TextField label="Search" placeholder-text="Search by name" name="Input" tooltip="Name" class="propertiesField" style="max-height: 25px; height: 25px; min-height: 25px; align-items: center; width: 160px; max-width: none; min-width: 150px;" />
                <ui:Button name="Button" tooltip="Bodies" class="toolboxButton" style="width: 20px; height: 20px;">
                    <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: resource(&apos;Icons/Explorer/Search&apos;); -unity-background-image-tint-color: rgb(0, 0, 0);" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:ScrollView name="List" style="height: auto; max-height: 200px;" />
        <ui:Label text="Create bodies to view them in the list." name="NoBodies" class="propertiesNoBody" style="display: flex; font-size: 12px; margin-top: 5px; margin-right: 5px; margin-bottom: 5px; margin-left: 5px;" />
    </ui:VisualElement>
    <ui:VisualElement name="ToolBox" class="toolboxBar">
        <ui:Button name="Explorer" tooltip="Explorer" class="toolboxButton" style="width: 30px; height: 30px; margin-left: 0; background-image: none; -unity-background-image-tint-color: rgb(255, 255, 255);">
            <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: url(&quot;project://database/Assets/Resources/Icons/Toolbox/Options/Explorer.png?fileID=2800000&amp;guid=1b449c8874814da4cb82ef156c737c84&amp;type=3#Explorer&quot;);" />
        </ui:Button>
        <ui:Button name="Bodies" tooltip="Bodies" class="toolboxButton">
            <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: url(&quot;project://database/Assets/Resources/Icons/Toolbox/Options/Bodies.png?fileID=2800000&amp;guid=4a14754fa7647d5449e16fd9d5cc8d1c&amp;type=3#Bodies&quot;);" />
        </ui:Button>
        <ui:Button name="Modes" tooltip="Placement Modes" class="toolboxButton">
            <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: url(&quot;project://database/Assets/Resources/Icons/Toolbox/Options/Modes.png?fileID=2800000&amp;guid=d172ff94ca33f404e92f3c2be36180a6&amp;type=3#Modes&quot;);" />
        </ui:Button>
        <ui:Button name="Distance" tooltip="Distance Units" class="toolboxButton">
            <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: url(&quot;project://database/Assets/Resources/Icons/Toolbox/Options/Distances.png?fileID=2800000&amp;guid=bf07420b50293f44faf4b820eb72bf0e&amp;type=3#Distances&quot;);" />
        </ui:Button>
        <ui:Button name="ToggleLabels" tooltip="Toggle Simulation Run" class="toolboxButton">
            <ui:VisualElement name="Disabled" class="toolboxButtonIcon" style="background-image: resource(&apos;Icons/General/Disabled&apos;); position: absolute; width: 22px; height: 22px; display: none;" />
            <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: resource(&apos;Icons/Toolbox/Options/tag&apos;);" />
        </ui:Button>
        <ui:Button name="TogglePlay" tooltip="Toggle Simulation Run" class="toolboxButton">
            <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: resource(&apos;Icons/Toolbox/Options/Paused&apos;);" />
        </ui:Button>
        <ui:Button name="ToggleFlow" tooltip="Toggle Simulation Run" class="toolboxButton">
            <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: resource(&apos;Icons/Toolbox/Options/FastForward&apos;);" />
        </ui:Button>
    </ui:VisualElement>
    <ui:VisualElement name="SubToolBox" class="toolboxBar" style="bottom: 40px; flex-direction: column; margin-left: 0;">
        <ui:VisualElement name="BodyList" class="toolboxList">
            <ui:Label text="Body" name="BodyLabel" style="-unity-font-style: bold; color: rgb(255, 255, 255);" />
            <ui:Button text="Star" name="Star" tooltip="Star" class="bodyButton toolboxButton" style="width: 45px;" />
            <ui:Button text="Planet" name="Planet" tooltip="Planet" class="bodyButton toolboxButton" style="width: 55px;" />
            <ui:Button text="Moon" name="Moon" enable-rich-text="true" tooltip="Moon" class="bodyButton toolboxButton" style="width: 50px;" />
        </ui:VisualElement>
        <ui:VisualElement name="ModeList" class="toolboxList">
            <ui:Label text="Mode" name="ModeLabel" style="-unity-font-style: bold; color: rgb(255, 255, 255); -unity-text-align: middle-left;" />
            <ui:Button name="FreePlacement" tooltip="Free Placement" class="toolboxButton">
                <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: url(&quot;project://database/Assets/Resources/Icons/Toolbox/Modes/FreePlacement.png?fileID=2800000&amp;guid=535f284cceb4c6a4888c71baed2a9e74&amp;type=3#FreePlacement&quot;);" />
            </ui:Button>
            <ui:Button name="PlanePlacement" tooltip="Plane Placement" class="toolboxButton">
                <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: url(&quot;project://database/Assets/Resources/Icons/Toolbox/Modes/PlanePlacement.png?fileID=2800000&amp;guid=23d228f527b6f7f4293db958b576c874&amp;type=3#PlanePlacement&quot;);" />
            </ui:Button>
            <ui:Button name="OrbitPlacement" tooltip="Orbit Placement" class="toolboxButton">
                <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: url(&quot;project://database/Assets/Resources/Icons/Toolbox/Modes/OrbitPlacement.png?fileID=2800000&amp;guid=1777bcebfa279584fa908aedbbee61ce&amp;type=3#OrbitPlacement&quot;);" />
            </ui:Button>
        </ui:VisualElement>
        <ui:VisualElement name="DistanceList" class="toolboxList">
            <ui:Label text="Distance" name="DistanceLabel" style="-unity-font-style: bold; color: rgb(255, 255, 255); -unity-text-align: middle-left;" />
            <ui:Button text="cm" name="Centimetre" tooltip="Centimetres" class="toolboxButton" />
            <ui:Button text="m" name="Metre" tooltip="Metres" class="toolboxButton" />
            <ui:Button text="km" name="Kilometre" tooltip="Kilometres" class="toolboxButton" />
            <ui:Button text="mi" name="Mile" tooltip="Miles" class="toolboxButton" />
            <ui:Button text="LD" name="Lunar_Distance" tooltip="Lunar Distance" class="toolboxButton" />
            <ui:Button text="AU" name="AU" tooltip="Astronomical Unit" class="toolboxButton" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:Label text="&lt;b&gt;Scale:&lt;/b&gt; 1 Kilometre x 1.000" name="Scale" style="position: absolute; -unity-text-align: upper-right; color: rgb(255, 255, 255); bottom: 0; right: 0;" />
    <ui:Label text="&lt;b&gt;Time:&lt;/b&gt; 1s / s" name="Time" enable-rich-text="true" style="position: absolute; -unity-text-align: upper-right; color: rgb(255, 255, 255); bottom: 25px; right: 0;" />
</ui:UXML>

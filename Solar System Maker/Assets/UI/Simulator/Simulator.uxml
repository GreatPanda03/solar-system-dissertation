<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Simulator/SimulatorStyles.uss?fileID=7433441132597879392&amp;guid=f640695c10d59ba4199d931b7b100157&amp;type=3#SimulatorStyles" />
    <ui:VisualElement name="Toolbar" class="toolbar">
        <ui:Button name="ExitSimulator" tooltip="Exit" class="toolboxButton">
            <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: resource(&apos;Icons/Toolbar/ExitSimulator&apos;);" />
        </ui:Button>
        <ui:Button name="Options" tooltip="Options" class="toolboxButton">
            <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: resource(&apos;Icons/Toolbar/Options&apos;);" />
        </ui:Button>
        <ui:Button name="Save" tooltip="Save" class="toolboxButton">
            <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: resource(&apos;Icons/Toolbar/Save&apos;);" />
        </ui:Button>
        <ui:Button name="SaveAs" tooltip="Save As" class="toolboxButton">
            <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: resource(&apos;Icons/Toolbar/SaveAs&apos;);" />
        </ui:Button>
        <ui:Button name="Help" tooltip="Help" class="toolboxButton">
            <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: resource(&apos;Icons/ToolBar/Help&apos;);" />
        </ui:Button>
        <ui:Label text="Simulation Name" name="Title" class="title" style="width: auto; height: 100%; -unity-text-align: lower-left; margin-top: 5px; margin-right: 5px; margin-bottom: 5px; margin-left: 10px;" />
    </ui:VisualElement>
    <ui:VisualElement name="BodyTools" class="toolboxBar" style="top: 0; bottom: auto; right: 0;">
        <ui:Button name="Properties" tooltip="Properties" class="toolboxButton" style="width: 30px; height: 30px; background-image: none; -unity-background-image-tint-color: rgb(255, 255, 255);">
            <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: resource(&apos;Icons/BodyTools/Properties&apos;);" />
        </ui:Button>
        <ui:Button name="Plane" tooltip="Fixate Plane" class="toolboxButton" style="width: 30px; height: 30px; background-image: none; -unity-background-image-tint-color: rgb(255, 255, 255);">
            <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: resource(&apos;Icons/BodyTools/Plane&apos;);" />
        </ui:Button>
        <ui:Button name="Follow" tooltip="Follow" class="toolboxButton">
            <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: resource(&apos;Icons/BodyTools/Follow&apos;);" />
        </ui:Button>
        <ui:Button name="Scale" tooltip="Scale" class="toolboxButton">
            <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: resource(&apos;Icons/BodyTools/Scale&apos;);" />
        </ui:Button>
        <ui:Button name="Label" tooltip="Toggle Label" class="toolboxButton">
            <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: resource(&apos;Icons/BodyTools/Label&apos;);" />
        </ui:Button>
        <ui:Button name="Trail" tooltip="Toggle Trail" class="toolboxButton">
            <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: resource(&apos;Icons/BodyTools/Trail&apos;);" />
        </ui:Button>
        <ui:Button name="Anchor" tooltip="Anchor" class="toolboxButton">
            <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: resource(&apos;Icons/BodyTools/Anchor&apos;);" />
        </ui:Button>
        <ui:Button name="Template" tooltip="Save As Template" class="toolboxButton">
            <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: resource(&apos;Icons/BodyTools/Template&apos;);" />
        </ui:Button>
        <ui:Button name="Delete" tooltip="Delete" class="toolboxButton">
            <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: resource(&apos;Icons/BodyTools/Delete&apos;);" />
        </ui:Button>
    </ui:VisualElement>
    <ui:VisualElement name="PropertiesPanel" class="propertiesPanel" style="background-color: rgba(0, 0, 0, 0.59); top: 40px; left: auto; right: 10px;">
        <ui:Button text="X" name="Close" class="propertiesClose" style="position: absolute;" />
        <ui:Label text="Properties" name="Title" class="propertiesTitle" style="display: flex; align-self: center;" />
        <ui:VisualElement name="Groups" style="flex-grow: 1; display: flex;">
            <ui:GroupBox name="Body" class="propertiesGroup" style="display: flex;">
                <ui:Label text="Body" name="Title" enable-rich-text="true" class="propertiesTitle propertiesSubtitle" style="display: flex;" />
                <ui:TextField label="Name" placeholder-text="(blank)" name="Name" tooltip="Name" class="propertiesField" />
                <ui:FloatField label="Mass (kg)" value="10" name="Mass" tooltip="Mass" class="propertiesField" />
                <ui:FloatField label="Radius (d)" value="10" name="Radius" tooltip="Radius" class="propertiesField" />
                <ui:FloatField label="Temp. (°C)" value="10" name="SurfaceTemp" tooltip="Surface Temperature" class="propertiesField" />
                <ui:FloatField label="Density(kg/m&lt;sup&gt;3&lt;/sup&gt;)" value="10" name="Density" tooltip="Density" class="propertiesField" />
                <ui:FloatField label="Speed (d/t)" value="10" name="Speed_custom" placeholder-text="(blank)" readonly="true" class="propertiesField" />
                <ui:FloatField label="Accel. (d/t&lt;sup&gt;2&lt;/sup&gt;)" value="10" name="Acceleration_custom" placeholder-text="(blank)" readonly="true" focusable="true" class="propertiesField" />
                <ui:FloatField label="Rotations (t)" value="10" name="Rotations_custom" placeholder-text="(blank)" readonly="true" focusable="true" class="propertiesField" />
            </ui:GroupBox>
            <ui:GroupBox name="Star" class="propertiesGroup" style="display: flex;">
                <ui:Label text="Star" name="Title" class="propertiesTitle propertiesSubtitle" style="display: flex;" />
                <ui:FloatField label="Luminosity (W)" value="10" name="Luminosity" tooltip="Luminosity" class="propertiesField" />
            </ui:GroupBox>
            <ui:GroupBox name="Planet" class="propertiesGroup" style="display: flex;">
                <ui:Label text="Planet" name="Title" class="propertiesTitle propertiesSubtitle" style="display: flex;" />
                <ui:FloatField label="Water (%)" value="10" name="WaterContent" tooltip="Water Content" class="propertiesField" />
                <ui:FloatField label="Habitability" value="10" name="Habitability" tooltip="Habitability" readonly="false" class="propertiesField" />
            </ui:GroupBox>
        </ui:VisualElement>
        <ui:Label text="Select a body in the system to see its properties" name="NoSelection" class="propertiesNoBody" style="display: none; margin-top: 5px; font-size: 12px;" />
    </ui:VisualElement>
    <ui:VisualElement name="Explorer" class="propertiesPanel" style="background-color: rgba(0, 0, 0, 0.59); top: auto; left: auto; right: 10px; bottom: 65px;">
        <ui:Button text="X" name="Close" class="propertiesClose" style="position: absolute;" />
        <ui:Label text="Explorer" name="Title" class="propertiesTitle" style="align-self: center; margin-bottom: 10px;" />
        <ui:VisualElement name="Filters" style="flex-grow: 1;">
            <ui:VisualElement name="Search" style="flex-grow: 1; flex-direction: row; align-items: center; margin-top: 5px; margin-bottom: 5px;">
                <ui:TextField label="Search" placeholder-text="Search by name" name="Input" tooltip="Name" class="propertiesField" style="max-height: 25px; height: 25px; min-height: 25px; align-items: center; width: 160px; max-width: none; min-width: 150px;" />
                <ui:Button name="Button" tooltip="Search" class="toolboxButton" style="width: 20px; height: 20px;">
                    <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: resource(&apos;Icons/Explorer/Search&apos;); -unity-background-image-tint-color: rgb(0, 0, 0);" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:ScrollView name="List" style="height: auto; max-height: 200px;" />
        <ui:Label text="Create bodies to view them in the list." name="NoBodies" class="propertiesNoBody" style="display: flex; font-size: 12px; margin-top: 5px; margin-right: 5px; margin-bottom: 5px; margin-left: 5px;" />
    </ui:VisualElement>
    <ui:VisualElement name="SubToolbox" class="toolboxBar" style="bottom: 40px; flex-direction: column; margin-left: 0;">
        <ui:VisualElement name="OrbitDetails" style="flex-grow: 1;">
            <ui:Label text="(Orbit Eccentricity = 0.000)" name="Eccentricity" style="-unity-font-style: normal; color: rgb(255, 255, 255);" />
            <ui:Label text="(Orbit Radius = No target)" name="OrbitRadius" style="-unity-font-style: normal; color: rgb(255, 255, 255);" />
        </ui:VisualElement>
        <ui:VisualElement name="DistanceList" class="toolboxList">
            <ui:Label text="Distance" name="DistanceLabel" style="-unity-font-style: bold; color: rgb(255, 255, 255); -unity-text-align: middle-left;" />
            <ui:Button text="cm" name="Centimetre" tooltip="Centimetre" class="toolboxButton" />
            <ui:Button text="m" name="Metre" tooltip="Metres" class="toolboxButton" />
            <ui:Button text="km" name="Kilometre" tooltip="Kilometres" class="toolboxButton" />
            <ui:Button text="mi" name="Mile" tooltip="Miles" class="toolboxButton" />
            <ui:Button text="E&lt;sub&gt;R&lt;/sub&gt;" name="Earth_Radius" tooltip="Earth Radii" class="toolboxButton" />
            <ui:Button text="S&lt;sub&gt;R&lt;/sub&gt;" name="Solar_Radius" tooltip="Solar Radii" class="toolboxButton" />
            <ui:Button text="LD" name="Lunar_Distance" tooltip="Lunar Distances" class="toolboxButton" />
            <ui:Button text="AU" name="AU" tooltip="Astronomical Units" class="toolboxButton" />
        </ui:VisualElement>
        <ui:VisualElement name="BodyList" class="toolboxList">
            <ui:Label text="Body" name="BodyLabel" style="-unity-font-style: bold; color: rgb(255, 255, 255);" />
            <ui:Button text="Star" name="Star" tooltip="Create Star" class="bodyButton toolboxButton" style="width: 45px;" />
            <ui:Button text="Planet" name="Planet" tooltip="Create Planet" class="bodyButton toolboxButton" style="width: 55px;" />
            <ui:Button text="Moon" name="Moon" enable-rich-text="true" tooltip="Create Moon" class="bodyButton toolboxButton" style="width: 50px;" />
            <ui:Button text="Templates&#10;" name="Templates" enable-rich-text="true" tooltip="View Templates" class="bodyButton toolboxButton" style="width: 80px;" />
        </ui:VisualElement>
        <ui:VisualElement name="PlaneList" class="toolboxList">
            <ui:Label text="Plane" name="PlaneLabel" style="-unity-font-style: bold; color: rgb(255, 255, 255);" />
            <ui:Button name="Stick" tooltip="Stick To Plane" class="toolboxButton">
                <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: resource(&apos;Icons/ToolBox/Plane/Stick&apos;);" />
            </ui:Button>
            <ui:Button name="Lower" tooltip="Lower Plane" class="toolboxButton">
                <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: resource(&apos;Icons/ToolBox/Plane/Lower&apos;);" />
            </ui:Button>
            <ui:Button name="Raise" tooltip="Raise Plane" class="toolboxButton">
                <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: resource(&apos;Icons/ToolBox/Plane/Raise&apos;);" />
            </ui:Button>
            <ui:Button name="TurnLeft" tooltip="Turn Plane Left" class="toolboxButton">
                <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: resource(&apos;Icons/ToolBox/Plane/TurnLeft&apos;);" />
            </ui:Button>
            <ui:Button name="TurnRight" tooltip="Turn Plane Right" class="toolboxButton">
                <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: resource(&apos;Icons/ToolBox/Plane/TurnRight&apos;);" />
            </ui:Button>
            <ui:Button name="TurnBackwards" tooltip="Turn Plane Backwards" class="toolboxButton">
                <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: resource(&apos;Icons/ToolBox/Plane/TurnBackwards&apos;);" />
            </ui:Button>
            <ui:Button name="TurnForwards" tooltip="Turn Plane Forwards" class="toolboxButton">
                <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: resource(&apos;Icons/ToolBox/Plane/TurnForwards&apos;);" />
            </ui:Button>
            <ui:Button name="Reset" tooltip="Reset To Origin" class="toolboxButton">
                <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: resource(&apos;Icons/ToolBox/Plane/Reset&apos;);" />
            </ui:Button>
        </ui:VisualElement>
        <ui:VisualElement name="TimeList" class="toolboxList">
            <ui:Label text="Time" name="TimeLabel" style="-unity-font-style: bold; color: rgb(255, 255, 255);" />
            <ui:Button name="Play" tooltip="Toggle Play" class="toolboxButton">
                <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: resource(&apos;Icons/Toolbox/Time/Play&apos;);" />
            </ui:Button>
            <ui:Button name="Flow" tooltip="Toggle Time Flow" class="toolboxButton">
                <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: resource(&apos;Icons/Toolbox/Time/Forward&apos;);" />
            </ui:Button>
            <ui:Button name="SlowTime" tooltip="Slow Time" class="toolboxButton">
                <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: resource(&apos;Icons/Toolbox/Time/SlowTime&apos;);" />
            </ui:Button>
            <ui:Button name="SpeedTime" tooltip="Speed Up Time" class="toolboxButton">
                <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: resource(&apos;Icons/Toolbox/Time/SpeedTime&apos;);" />
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="Toolbox" class="toolboxBar">
        <ui:Button name="Explorer" tooltip="Explorer" class="toolboxButton" style="width: 30px; height: 30px; margin-left: 0; background-image: none; -unity-background-image-tint-color: rgb(255, 255, 255);">
            <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: url(&quot;project://database/Assets/Resources/Icons/Toolbox/Options/Explorer.png?fileID=2800000&amp;guid=1b449c8874814da4cb82ef156c737c84&amp;type=3#Explorer&quot;);" />
        </ui:Button>
        <ui:Button name="Bodies" tooltip="Bodies" class="toolboxButton">
            <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: url(&quot;project://database/Assets/Resources/Icons/Toolbox/Options/Bodies.png?fileID=2800000&amp;guid=4a14754fa7647d5449e16fd9d5cc8d1c&amp;type=3#Bodies&quot;);" />
        </ui:Button>
        <ui:Button name="Plane" tooltip="Plane Placement" class="toolboxButton">
            <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: url(&quot;project://database/Assets/Resources/Icons/Toolbox/Options/Plane.png?fileID=2800000&amp;guid=23d228f527b6f7f4293db958b576c874&amp;type=3#Plane&quot;);" />
        </ui:Button>
        <ui:Button name="Orbit" tooltip="Toggle Orbit Mode" class="toolboxButton">
            <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: url(&quot;project://database/Assets/Resources/Icons/Toolbox/Options/Orbit.png?fileID=2800000&amp;guid=1777bcebfa279584fa908aedbbee61ce&amp;type=3#Orbit&quot;);" />
        </ui:Button>
        <ui:Button name="Distance" tooltip="Distance Units" class="toolboxButton">
            <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: url(&quot;project://database/Assets/Resources/Icons/Toolbox/Options/Distances.png?fileID=2800000&amp;guid=bf07420b50293f44faf4b820eb72bf0e&amp;type=3#Distances&quot;);" />
        </ui:Button>
        <ui:Button name="Labels" tooltip="Toggle Labels" class="toolboxButton">
            <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: resource(&apos;Icons/ToolBox/Options/Labels&apos;);" />
        </ui:Button>
        <ui:Button name="Trails" tooltip="Toggle Trails" class="toolboxButton">
            <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: resource(&apos;Icons/ToolBox/Options/Trails&apos;);" />
        </ui:Button>
        <ui:Button name="Time" tooltip="Toggle Play" class="toolboxButton">
            <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: resource(&apos;Icons/ToolBox/Options/Time&apos;);" />
        </ui:Button>
        <ui:Button name="Skybox" tooltip="Toggle Background" class="toolboxButton">
            <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: resource(&apos;Icons/Toolbox/Options/Skybox&apos;);" />
        </ui:Button>
    </ui:VisualElement>
    <ui:Label text="&lt;b&gt;Scale:&lt;/b&gt; 1 Kilometre x 1.000" name="Scale" style="position: absolute; -unity-text-align: upper-right; color: rgb(255, 255, 255); bottom: 0; right: 0;" />
    <ui:Label text="&lt;b&gt;Time:&lt;/b&gt; 1 second / s" name="Time" enable-rich-text="true" style="position: absolute; -unity-text-align: upper-right; color: rgb(255, 255, 255); bottom: 25px; right: 0;" />
</ui:UXML>

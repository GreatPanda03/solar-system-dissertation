.toolbar {
    height: 50px;
    max-height: 50px;
    min-height: 50px;
    align-items: flex-start;
    justify-content: flex-start;
    align-self: flex-start;
    flex-direction: column;
    padding-right: 5px;
    padding-left: 5px;
}

.title {
    -unity-text-align: middle-left;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    padding-right: 0;
    padding-left: 0;
    flex-basis: auto;
    width: auto;
    padding-top: 0;
    padding-bottom: 0;
}

.options {
    width: 100%;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 5px;
    padding-left: 0;
    flex-direction: row;
}

.bodyButton {
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    margin-right: 0;
    transition-duration: 0.25s;
}

.bodyButton:hover {
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    margin-right: 0;
    transition-duration: 0.25s;
}

.selectedButton {
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    margin-right: 0;
    background-color: rgb(162, 217, 255);
    transition-duration: 0.25s;
}

.selectedButton:hover {
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    margin-right: 0;
    background-color: rgb(107, 198, 255);
    transition-duration: 0.25s;
}

.saveButton {
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    height: 100%;
    font-size: 12px;
    background-color: rgb(3, 190, 17);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    transition-duration: 0.25s;
    margin-right: 5px;
}

.exitButton {
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    height: 100%;
    font-size: 12px;
    background-color: rgb(255, 78, 78);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    transition-duration: 0.25s;
}

.exitButton:hover {
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    height: 100%;
    font-size: 12px;
    background-color: rgb(255, 49, 49);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    transition-duration: 0.25s;
}

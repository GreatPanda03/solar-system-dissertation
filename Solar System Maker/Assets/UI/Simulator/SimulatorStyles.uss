.title {
    -unity-text-align: middle-left;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    padding-right: 0;
    padding-left: 0;
    flex-basis: auto;
    width: auto;
    padding-top: 0;
    padding-bottom: 0;
}

.options {
    width: 100%;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 5px;
    padding-left: 0;
    flex-direction: row;
}

.saveButton {
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    height: 100%;
    font-size: 12px;
    background-color: rgb(3, 190, 17);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    transition-duration: 0.25s;
    margin-right: 5px;
}

.exitButton {
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    height: 100%;
    font-size: 12px;
    background-color: rgb(255, 78, 78);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    transition-duration: 0.25s;
}

.exitButton:hover {
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    height: 100%;
    font-size: 12px;
    background-color: rgb(255, 49, 49);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    transition-duration: 0.25s;
}

.propertiesPanel {
    position: absolute;
    width: 200px;
    height: auto;
    left: 250px;
    top: 50px;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
}

.propertiesTitle {
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    padding-right: 0;
    padding-left: 0;
    flex-basis: auto;
    width: auto;
    padding-top: 0;
    padding-bottom: 0;
    font-size: 14px;
    max-height: 15px;
    min-height: 15px;
    height: 15px;
}

.propertiesSubtitle {
    -unity-text-align: middle-left;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    padding-right: 0;
    padding-left: 0;
    flex-basis: auto;
    width: auto;
    padding-top: 0;
    padding-bottom: 0;
    max-height: 10px;
    min-height: 10px;
    height: 10px;
    font-size: 12px;
}

.divider {
    height: 3px;
    max-height: 3px;
    min-height: 3px;
    background-color: rgba(255, 255, 255, 0.59);
    margin-top: 5px;
    margin-bottom: 5px;
}

.propertiesNoBody {
    height: auto;
    color: rgb(255, 255, 255);
    white-space: normal;
    word-spacing: 0;
    -unity-text-align: upper-center;
    -unity-font-style: italic;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
}

.propertiesGroup {
    margin-top: 5px;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.propertiesField {
    max-height: 20px;
    font-size: 12px;
    margin-top: 1px;
    margin-right: 1px;
    margin-bottom: 1px;
    margin-left: 1px;
}

.propertiesPanel .unity-label {
    color: rgb(255, 255, 255);
    min-width: auto;
    flex-basis: 40%;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.propertiesPanel .unity-base-text-field__input {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    -unity-text-align: middle-left;
    flex-basis: auto;
}

.propertiesFields .unity-label {
    color: rgb(255, 255, 255);
    min-width: auto;
    flex-basis: 40%;
    -unity-text-align: upper-left;
    font-size: 12px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.propertiesClose {
    width: 10px;
    height: 10px;
    max-height: 10px;
    min-height: 10px;
    min-width: 10px;
    max-width: 10px;
    background-color: rgba(255, 255, 255, 0);
    color: rgb(255, 6, 6);
    -unity-font-style: bold;
    border-left-color: rgba(255, 255, 255, 0);
    border-right-color: rgba(255, 255, 255, 0);
    border-top-color: rgba(255, 255, 255, 0);
    border-bottom-color: rgba(255, 255, 255, 0);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
}

.toolboxBar {
    bottom: 0;
    position: absolute;
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
    flex-direction: row;
}

.toolboxList {
    flex-direction: row;
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
}

.toolboxButton {
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    transition-duration: 0.25s;
    margin-bottom: 0;
    margin-left: 5px;
    margin-top: 0;
    margin-right: 0;
    width: 30px;
    height: 30px;
    padding-top: 3px;
    padding-right: 3px;
    padding-bottom: 3px;
    padding-left: 3px;
}

.toolboxButton:hover {
    transition-property: rotate;
    transition-duration: 0.25s;
    rotate: 10deg;
}

.toolboxButtonIcon {
    flex-grow: 1;
    background-color: rgba(255, 255, 255, 0);
    -unity-background-image-tint-color: rgb(0, 0, 0);
}

.selectedButton {
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    margin-right: 0;
    background-color: rgb(162, 217, 255);
    transition-duration: 0.25s;
    margin-left: 5px;
}

.selectedButton:hover {
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    margin-right: 0;
    background-color: rgb(107, 198, 255);
    transition-duration: 0.25s;
    margin-left: 5px;
}

.toolboxBar {
    bottom: 0;
    position: absolute;
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
    flex-direction: row;
}

.unity-scroller--vertical {
    max-width: 5px;
    min-width: 5px;
    width: 5px;
}

.unity-scroller__low-button {
    max-width: 5px;
    min-width: 5px;
    width: 5px;
}

.unity-scroller__high-button {
    max-width: 5px;
    min-width: 5px;
    width: 5px;
}

.unity-scroller__slider {
    max-width: 5px;
    min-width: 5px;
    width: 5px;
}

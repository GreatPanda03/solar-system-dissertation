<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Simulator/SimulatorStyles.uss?fileID=7433441132597879392&amp;guid=f640695c10d59ba4199d931b7b100157&amp;type=3#SimulatorStyles" />
    <ui:VisualElement name="ToolBar" class="toolbar" style="flex-grow: 1; height: 30px; width: 100%; flex-direction: row; max-height: 30px; min-height: 30px; padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 0;">
        <ui:Button name="ExitSimulator" tooltip="Exit Simulation" class="toolboxButton">
            <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: resource(&apos;Icons/Toolbar/ExitSimulation&apos;);" />
        </ui:Button>
        <ui:Button name="SaveSimulation" tooltip="Save Simulation" class="toolboxButton">
            <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: resource(&apos;Icons/Toolbar/SaveSimulation&apos;);" />
        </ui:Button>
        <ui:Label text="Simulation Name" name="Title" class="title" style="width: auto; height: 100%; -unity-text-align: lower-left; margin-top: 5px; margin-right: 5px; margin-bottom: 5px; margin-left: 10px;" />
    </ui:VisualElement>
    <ui:VisualElement name="Properties" class="propertiesPanel" style="background-color: rgba(0, 0, 0, 0.59); top: 10px; left: auto; right: 10px;">
        <ui:Button text="X" name="PropertiesClose" class="propertiesClose" style="position: absolute;" />
        <ui:Label text="Properties" name="PropertiesTitle" class="propertiesTitle" />
        <ui:VisualElement name="Divider" class="divider" style="flex-grow: 1;" />
        <ui:VisualElement name="PropertyGroups" style="flex-grow: 1; display: none;">
            <ui:GroupBox name="Properties_Body" class="propertiesGroup">
                <ui:Label text="General" name="Properties_BodyTitle" class="propertiesSubtitle" />
                <ui:VisualElement name="BodyFields" class="propertiesFields" style="flex-grow: 1;">
                    <ui:TextField label="Name" placeholder-text="(blank)" name="Body_Name" tooltip="Name" class="propertiesField" />
                    <ui:FloatField label="Mass" value="10" name="Body_Mass" tooltip="Mass" class="propertiesField" />
                    <ui:FloatField label="Radius" value="10" name="Body_Radius" tooltip="Radius" class="propertiesField" />
                    <ui:FloatField label="Speed" value="10" name="Body_Speed" tooltip="Speed (Magnitude)" readonly="true" class="propertiesField" />
                    <ui:FloatField label="Surface Temp." value="10" name="Body_SurfaceTemp" tooltip="Surface Temperature" class="propertiesField" />
                    <ui:FloatField label="Density" value="10" name="Body_Density" tooltip="Density" class="propertiesField" />
                </ui:VisualElement>
            </ui:GroupBox>
            <ui:GroupBox name="Properties_Star" class="propertiesGroup">
                <ui:Label text="Star" name="Properties_StarTitle" class="propertiesSubtitle" />
                <ui:VisualElement name="StarFields" class="propertiesFields" style="flex-grow: 1;">
                    <ui:FloatField label="Luminosity" value="0" name="Star_Luminosity" tooltip="Luminosity" class="propertiesField" />
                </ui:VisualElement>
            </ui:GroupBox>
            <ui:GroupBox name="Properties_Planet" class="propertiesGroup">
                <ui:Label text="Planet" name="Properties_PlanetTitle" class="propertiesSubtitle" />
                <ui:VisualElement name="PlanetFields" class="propertiesFields" style="flex-grow: 1;">
                    <ui:FloatField label="Water Content" value="0" name="Planet_WaterContent" tooltip="Water Content" class="propertiesField" />
                    <ui:FloatField label="Habitability" value="0" name="Planet_Habitability" tooltip="Habitability" readonly="true" class="propertiesField" />
                </ui:VisualElement>
            </ui:GroupBox>
        </ui:VisualElement>
        <ui:Label text="Select a body in the system to see its properties" name="NoSelectedBody" class="propertiesNoBody" />
    </ui:VisualElement>
    <ui:VisualElement name="Explorer" class="propertiesPanel" style="background-color: rgba(0, 0, 0, 0.59); top: auto; left: auto; right: 10px; bottom: 40px;">
        <ui:Button text="X" name="ExplorerClose" class="propertiesClose" style="position: absolute;" />
        <ui:Label text="Explorer" name="ExplorerTitle" class="propertiesTitle" />
        <ui:VisualElement name="Divider" class="divider" style="flex-grow: 1;" />
        <ui:ScrollView name="ExplorerList" style="height: auto; max-height: 200px;" />
        <ui:Label text="Create bodies to view them in the list." name="NoExplorerContents" class="propertiesNoBody" style="display: none;" />
    </ui:VisualElement>
    <ui:VisualElement name="ToolBox" class="toolboxBar">
        <ui:Button name="Explorer" tooltip="Explorer" class="toolboxButton" style="width: 30px; height: 30px; margin-left: 0; background-image: none; -unity-background-image-tint-color: rgb(255, 255, 255);">
            <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: url(&quot;project://database/Assets/Resources/Icons/Toolbox/Options/Explorer.png?fileID=2800000&amp;guid=68d64274fbde6ec4998749f5c4ed5273&amp;type=3#Explorer&quot;);" />
        </ui:Button>
        <ui:Button name="Bodies" tooltip="Bodies" class="toolboxButton">
            <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: url(&quot;project://database/Assets/Resources/Icons/Toolbox/Options/Bodies.png?fileID=2800000&amp;guid=29b80d331e2cd414b8c363f88e0853f1&amp;type=3#Bodies&quot;);" />
        </ui:Button>
        <ui:Button name="Modes" tooltip="Placement Modes" class="toolboxButton">
            <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: url(&quot;project://database/Assets/Resources/Icons/Toolbox/Options/Modes.png?fileID=2800000&amp;guid=0afd0ed95280851439b76ad51578880f&amp;type=3#Modes&quot;);" />
        </ui:Button>
        <ui:Button name="Distance" tooltip="Distance Units" class="toolboxButton">
            <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: url(&quot;project://database/Assets/Resources/Icons/Toolbox/Options/Distances.png?fileID=2800000&amp;guid=a51eb8f2cb0ac3b45807fb057bb49410&amp;type=3#Distances&quot;);" />
        </ui:Button>
        <ui:Button name="TogglePlay" tooltip="Toggle Simulation Run" class="toolboxButton">
            <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: resource(&apos;Icons/Toolbox/Options/Paused&apos;);" />
        </ui:Button>
    </ui:VisualElement>
    <ui:VisualElement name="SubToolBox" class="toolboxBar" style="bottom: 40px; flex-direction: column; margin-left: 0;">
        <ui:VisualElement name="BodyList" class="toolboxList">
            <ui:Label text="Body" name="BodyLabel" style="-unity-font-style: bold; color: rgb(255, 255, 255);" />
            <ui:Button text="Star" name="AddStar" tooltip="Star" class="bodyButton toolboxButton" style="width: 45px;" />
            <ui:Button text="Planet" name="AddPlanet" tooltip="Planet" class="bodyButton toolboxButton" style="width: 55px;" />
            <ui:Button text="Moon" name="AddMoon" enable-rich-text="true" tooltip="Moon" class="bodyButton toolboxButton" style="width: 50px;" />
        </ui:VisualElement>
        <ui:VisualElement name="ModeList" class="toolboxList">
            <ui:Label text="Mode" name="ModeLabel" style="-unity-font-style: bold; color: rgb(255, 255, 255); -unity-text-align: middle-left;" />
            <ui:Button name="FreePlacement" tooltip="Free Placement" class="toolboxButton">
                <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: url(&quot;project://database/Assets/Resources/Icons/Toolbox/Modes/FreePlacement.png?fileID=2800000&amp;guid=c9aaeae0199c0014089c88f9753c81c3&amp;type=3#FreePlacement&quot;);" />
            </ui:Button>
            <ui:Button name="PlanePlacement" tooltip="Plane Placement" class="toolboxButton">
                <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: url(&quot;project://database/Assets/Resources/Icons/Toolbox/Modes/PlanePlacement.png?fileID=2800000&amp;guid=cc2df80b634166d4da0d3e29d6407efd&amp;type=3#PlanePlacement&quot;);" />
            </ui:Button>
            <ui:Button name="OrbitPlacement" tooltip="Orbit Placement" class="toolboxButton">
                <ui:VisualElement name="Icon" class="toolboxButtonIcon" style="background-image: url(&quot;project://database/Assets/Resources/Icons/Toolbox/Modes/OrbitPlacement.png?fileID=2800000&amp;guid=20bdd7bcd8c0ce9458d9313246507c42&amp;type=3#OrbitPlacement&quot;);" />
            </ui:Button>
        </ui:VisualElement>
        <ui:VisualElement name="DistanceList" class="toolboxList">
            <ui:Label text="Distance" name="DistanceLabel" style="-unity-font-style: bold; color: rgb(255, 255, 255); -unity-text-align: middle-left;" />
            <ui:Button text="cm" name="Centimetre" tooltip="Centimetres" class="toolboxButton" />
            <ui:Button text="m" name="Metre" tooltip="Metres" class="toolboxButton" />
            <ui:Button text="km" name="Kilometre" tooltip="Kilometres" class="toolboxButton" />
            <ui:Button text="mi" name="Mile" tooltip="Miles" class="toolboxButton" />
            <ui:Button text="LD" name="LunarDistance" tooltip="Lunar Distance" class="toolboxButton" />
            <ui:Button text="AU" name="AU" tooltip="Astronomical Unit" class="toolboxButton" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:Label text="&lt;b&gt;Scale:&lt;/b&gt; 1 AU" name="Scale" style="position: absolute; -unity-text-align: upper-right; color: rgb(255, 255, 255); bottom: 0; right: 0;" />
</ui:UXML>

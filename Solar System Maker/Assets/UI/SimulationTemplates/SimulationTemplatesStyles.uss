#Outer {
    width: 100%;
    height: 100%;
    max-height: 100%;
    max-width: 100%;
    min-width: 100%;
    min-height: 100%;
    justify-content: center;
}

#Container {
    background-color: rgba(0, 0, 0, 0.78);
    padding-right: 5px;
    padding-left: 5px;
    width: 600px;
    height: 500px;
    max-height: 500px;
    max-width: 600px;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
}

#Header {
    flex-basis: 5%;
    justify-content: center;
}

#Close {
    background-color: rgb(255, 88, 88);
    width: 50px;
    min-width: 50px;
    max-width: 50px;
    max-height: 60%;
    position: absolute;
    height: 60%;
    min-height: 60%;
    color: rgb(255, 255, 255);
}

.divider {
    height: 3px;
    max-height: 3px;
    min-height: 3px;
    background-color: rgba(255, 255, 255, 0.59);
    margin-top: 5px;
    margin-bottom: 5px;
}

#Title {
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    align-items: stretch;
    position: relative;
    font-size: 16px;
    width: 50%;
    align-self: center;
}

#Content {
    flex-basis: 80%;
    flex-direction: row;
    flex-wrap: wrap;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    white-space: nowrap;
    -unity-text-align: middle-left;
}

#List {
    flex-basis: 65%;
}

#Viewer {
    flex-basis: 30%;
}

.viewerTitle {
    -unity-font-style: bold;
    font-size: 16px;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    width: 50%;
}

.viewerDescription {
    height: auto;
    color: rgb(255, 255, 255);
    white-space: normal;
    word-spacing: 0;
    -unity-text-align: upper-center;
}

#Load {
    max-width: none;
    color: rgb(0, 0, 0);
}

#Delete {
    max-width: none;
}

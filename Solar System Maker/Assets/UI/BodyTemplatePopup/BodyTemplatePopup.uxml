<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/BodyTemplatePopup/BodyTemplatePopupStyles.uss?fileID=7433441132597879392&amp;guid=bb4cbbcad914cf74ea7ef7ca8d388118&amp;type=3#BodyTemplatePopupStyles" />
    <ui:VisualElement name="Outer" style="flex-grow: 1; height: 447px;">
        <ui:VisualElement name="Container">
            <ui:VisualElement name="Header" style="flex-grow: 1;">
                <ui:Button text="X" name="Close" class="close" />
                <ui:Label text="Create a Body Template" name="Title" class="title" />
            </ui:VisualElement>
            <ui:VisualElement name="Content" style="flex-grow: 1;">
                <ui:Label text="&lt;b&gt;Your simulation has been paused.&lt;/b&gt;&#10;You can create a reusable template out of the selected body. Please provide a name. You can also give a description." name="Information" />
                <ui:VisualElement name="Fields" style="flex-grow: 1;">
                    <ui:TextField label="Name" placeholder-text="(blank)" name="Name" select-all-on-focus="false" select-all-on-mouse-up="false" style="color: rgb(255, 255, 255);" />
                    <ui:TextField label="Description" placeholder-text="(blank)" name="Description" select-all-on-focus="false" select-all-on-mouse-up="false" />
                </ui:VisualElement>
                <ui:Label name="Validation" />
            </ui:VisualElement>
            <ui:VisualElement name="Footer" style="flex-grow: 1;">
                <ui:Button text="Save" name="Save" class="loadButton" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

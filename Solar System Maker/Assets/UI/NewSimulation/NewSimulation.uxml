<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/NewSimulation/NewSimulationStyles.uss?fileID=7433441132597879392&amp;guid=11924aa3a2d607242afc23ab291ebf42&amp;type=3#NewSimulationStyles" />
    <ui:VisualElement name="Outer">
        <ui:VisualElement name="Container">
            <ui:VisualElement name="Header" style="height: 10%;">
                <ui:Button text="X" name="Close" class="propertiesClose" style="position: absolute;" />
                <ui:Label text="Create a New Simulation" name="Title" />
            </ui:VisualElement>
            <ui:VisualElement name="Content" style="flex-grow: 1;">
                <ui:VisualElement name="Name" class="field" style="flex-grow: 1; flex-direction: row; -unity-text-align: middle-left; flex-basis: 100%; height: 15%; max-height: 20%; min-height: 20px;">
                    <ui:Label text="Name" name="Label" style="flex-basis: 30%; color: rgb(255, 255, 255); -unity-text-align: middle-right; font-size: 16px;" />
                    <ui:TextField placeholder-text="A name for your simulation" name="Input" hide-placeholder-on-focus="false" password="false" value="New Simulation" style="color: rgb(0, 0, 0); -unity-text-align: middle-left; opacity: 1; -unity-text-outline-color: rgb(255, 255, 255); -unity-text-outline-width: 0; white-space: normal; text-overflow: clip; font-size: 14px; flex-basis: 65%; flex-direction: row;" />
                </ui:VisualElement>
                <ui:VisualElement name="Description" class="field" style="flex-grow: 1; flex-direction: row; -unity-text-align: middle-left; flex-basis: 100%; height: 30%; max-height: 30%; min-height: 30%;">
                    <ui:Label text="Description" name="Label" style="flex-basis: 30%; color: rgb(255, 255, 255); -unity-text-align: middle-right; font-size: 16px;" />
                    <ui:TextField placeholder-text="A description for your simulation" name="Input" multiline="true" style="color: rgb(0, 0, 0); -unity-text-align: middle-left; opacity: 1; -unity-text-outline-color: rgb(255, 255, 255); -unity-text-outline-width: 0; white-space: normal; text-overflow: clip; font-size: 14px; flex-basis: 65%; flex-direction: row;" />
                </ui:VisualElement>
                <ui:VisualElement name="GravitationalConstant" class="field" style="flex-grow: 1; flex-direction: row; -unity-text-align: middle-left; flex-basis: 100%; height: 15%; max-height: 20%; min-height: 20px;">
                    <ui:Label text="G" name="Label" style="flex-basis: 30%; color: rgb(255, 255, 255); -unity-text-align: middle-right; font-size: 16px;" />
                    <ui:FloatField value="0.01" name="Input" max-length="100" tooltip="The strength of gravity throughout the simulation" placeholder-text="(blank)" password="false" readonly="false" hide-placeholder-on-focus="false" mask-character="*" style="flex-basis: 65%; -unity-text-outline-color: rgba(255, 255, 255, 0);" />
                </ui:VisualElement>
                <ui:Label name="Validation" enable-rich-text="true" style="color: rgb(224, 114, 37); -unity-font-style: normal;" />
            </ui:VisualElement>
            <ui:VisualElement name="Footer" style="height: 10%; flex-wrap: nowrap; flex-direction: row; justify-content: center;">
                <ui:Button text="Create Simulation" name="Create" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

#Outer {
    min-width: 100%;
    min-height: 100%;
    justify-content: center;
    max-width: 100%;
    max-height: 100%;
    height: 100%;
    width: 100%;
    flex-grow: 0;
}

#Container {
    background-color: rgba(0, 0, 0, 0.78);
    height: 300px;
    width: 400px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    padding-top: 1%;
    padding-right: 1%;
    padding-bottom: 1%;
    padding-left: 1%;
    align-self: center;
    flex-grow: 0;
}

#Header {
    margin-bottom: 5%;
}

#Close {
    width: 10px;
    height: 10px;
    max-height: 10px;
    min-height: 10px;
    min-width: 10px;
    max-width: 10px;
    background-color: rgba(255, 255, 255, 0);
    color: rgb(255, 6, 6);
    -unity-font-style: bold;
    border-left-color: rgba(255, 255, 255, 0);
    border-right-color: rgba(255, 255, 255, 0);
    border-top-color: rgba(255, 255, 255, 0);
    border-bottom-color: rgba(255, 255, 255, 0);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
}

#Title {
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&guid=90d973a7d54dcce4c978f2d90dc13a4e&type=3#NotInter-Regular");
    font-size: 100%;
    justify-content: center;
    align-self: center;
}

#Content {
    flex-basis: 80%;
    flex-direction: row;
    flex-wrap: wrap;
}

.field {
    margin-bottom: 2%;
    min-height: 20%;
    -unity-text-align: middle-left;
}

#unity-text-input {
    margin-bottom: 2%;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    min-height: 100%;
}

#Footer {
    margin-bottom: 5px;
}

#Validation {
    color: rgb(224, 185, 37);
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    min-width: 100%;
}

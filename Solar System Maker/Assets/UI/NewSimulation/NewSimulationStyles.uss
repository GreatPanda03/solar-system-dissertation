.container {
    background-color: rgba(0, 0, 0, 0.78);
    height: 300px;
    width: 400px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    padding-top: 1%;
    padding-right: 1%;
    padding-bottom: 1%;
    padding-left: 1%;
    align-self: center;
}

.header {
}

.divider {
    height: 3px;
    max-height: 3px;
    min-height: 3px;
    background-color: rgba(255, 255, 255, 0.59);
    margin-top: 5px;
    margin-bottom: 5px;
}

.close {
    width: 10px;
    height: 10px;
    max-height: 10px;
    min-height: 10px;
    min-width: 10px;
    max-width: 10px;
    background-color: rgba(255, 255, 255, 0);
    color: rgb(255, 6, 6);
    -unity-font-style: bold;
    border-left-color: rgba(255, 255, 255, 0);
    border-right-color: rgba(255, 255, 255, 0);
    border-top-color: rgba(255, 255, 255, 0);
    border-bottom-color: rgba(255, 255, 255, 0);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
}

.title {
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&guid=90d973a7d54dcce4c978f2d90dc13a4e&type=3#NotInter-Regular");
    font-size: 100%;
    justify-content: center;
    align-self: center;
}

.content {
    flex-basis: 80%;
    flex-direction: row;
    flex-wrap: wrap;
}

.field {
    margin-bottom: 2%;
}

.footer {
    margin-bottom: 5px;
}

.validation {
    color: rgb(224, 84, 37);
    -unity-font-style: bold;
    -unity-text-align: upper-center;
}

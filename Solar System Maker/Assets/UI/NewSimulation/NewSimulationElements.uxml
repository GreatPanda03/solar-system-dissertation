<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/NewSimulation/NewSimulationStyles.uss?fileID=7433441132597879392&amp;guid=11924aa3a2d607242afc23ab291ebf42&amp;type=3#NewSimulationStyles" />
    <ui:VisualElement name="VisualElement" style="flex-grow: 1; align-self: center; justify-content: center; align-content: center; position: relative; max-height: none; display: flex; align-items: center; visibility: visible;">
        <ui:VisualElement name="Container" class="container" style="display: flex;">
            <ui:VisualElement name="Header" class="header" style="height: 10%;">
                <ui:Label text="Create a New Simulation" name="Con_NS_Title" class="new_simulation title" />
            </ui:VisualElement>
            <ui:VisualElement name="Divider" class="divider" style="flex-grow: 1; margin-bottom: 10px; border-top-left-radius: 1.5px; border-top-right-radius: 1.5px; border-bottom-right-radius: 1.5px; border-bottom-left-radius: 1.5px;" />
            <ui:VisualElement name="Content" style="flex-grow: 1; max-height: 70%; min-height: 70px; height: 70px;">
                <ui:VisualElement name="SimulationName" class="field" style="flex-grow: 1; flex-direction: row; -unity-text-align: middle-left; flex-basis: 100%; height: 15%; max-height: 20%; min-height: 20px;">
                    <ui:Label text="Simulation&#10;Name" name="SimulationNameLabel" style="flex-basis: 30%; color: rgb(255, 255, 255); -unity-text-align: middle-right; font-size: 16px;" />
                    <ui:TextField placeholder-text="(blank)" name="SimulationNameInput" hide-placeholder-on-focus="false" password="false" tooltip="The name of your simulation" value="New Simulation" style="color: rgb(0, 0, 0); -unity-text-align: middle-left; opacity: 1; -unity-text-outline-color: rgb(255, 255, 255); -unity-text-outline-width: 0; white-space: normal; text-overflow: clip; font-size: 14px; flex-basis: 65%; flex-direction: row;" />
                </ui:VisualElement>
                <ui:VisualElement name="GravityConstant" class="field" style="flex-grow: 1; flex-direction: row; -unity-text-align: middle-left; flex-basis: 100%; height: 15%; max-height: 20%; min-height: 20px;">
                    <ui:Label text="Gravity&#10;Constant" name="GravityConstantLabel" style="flex-basis: 30%; color: rgb(255, 255, 255); -unity-text-align: middle-right; font-size: 16px;" />
                    <ui:FloatField value="0.0001" name="GravityConstantInput" max-length="100" tooltip="The strength of gravity throughout the simulation" placeholder-text="(blank)" mask-character="w" password="false" readonly="false" hide-placeholder-on-focus="false" style="flex-basis: 65%; -unity-text-outline-color: rgba(255, 255, 255, 0);" />
                </ui:VisualElement>
                <ui:VisualElement name="GravityAlgorithm" class="field" style="flex-grow: 1; flex-direction: row; -unity-text-align: middle-left; flex-basis: 100%; height: 15%; max-height: 20%; min-height: 20px;">
                    <ui:Label text="Gravity&#10;Algorithm" name="GravityAlgorithmLabel" style="flex-basis: 30%; color: rgb(255, 255, 255); -unity-text-align: middle-right; font-size: 16px;" />
                    <ui:DropdownField choices="Newtonian Physics" name="GravityAlgorithmInput" index="0" style="-unity-text-outline-color: rgb(255, 255, 255); flex-basis: 65%;" />
                </ui:VisualElement>
                <ui:Label name="Validation" class="validation" />
            </ui:VisualElement>
            <ui:VisualElement name="Footer" class="footer" style="height: 10%; flex-wrap: nowrap; flex-direction: row; justify-content: center;">
                <ui:Button text="Create Simulation" name="CreateSimulation" style="width: 60%; align-self: center; background-color: rgb(99, 204, 104); font-size: 12px;" />
                <ui:Button text="Close" name="CloseWindow" style="width: 20%; align-self: center; background-color: rgb(209, 86, 86); font-size: 12px;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

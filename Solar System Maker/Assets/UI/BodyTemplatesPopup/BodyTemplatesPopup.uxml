<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/BodyTemplatesPopup/BodyTemplatesPopupStyles.uss?fileID=7433441132597879392&amp;guid=1f73784ed9e6fad4ca678484d1d3187f&amp;type=3#BodyTemplatesPopupStyles" />
    <ui:VisualElement name="Container" style="flex-grow: 1; display: flex; flex-direction: row; width: 100%; height: 100%; max-width: 100%; max-height: 100%; background-color: rgba(0, 0, 0, 0); justify-content: center;">
        <ui:VisualElement name="Container" class="container" style="flex-grow: 1; display: flex; flex-direction: column;">
            <ui:VisualElement name="Header" class="header" style="flex-grow: 1;">
                <ui:Button text="X" name="Close" class="close" />
                <ui:Label text="Saved Body Templates" name="Title" />
            </ui:VisualElement>
            <ui:VisualElement name="Divider" class="divider" style="flex-grow: 1;" />
            <ui:VisualElement name="Content" class="content" style="align-content: center; align-items: stretch; justify-content: center;">
                <ui:ScrollView name="List" class="saveList" />
                <ui:VisualElement name="Divider" class="divider" style="flex-grow: 1; height: auto; max-height: none; min-height: auto; width: 1px; max-width: 1px; min-width: 1px; background-color: rgba(255, 255, 255, 0.39); margin-right: 5px; margin-left: 5px;" />
                <ui:VisualElement name="Viewer" class="saveViewer" style="flex-grow: 1;">
                    <ui:Label text="Select a template from the list to view its details." name="NoSelection" class="viewerDescription" style="display: flex; -unity-text-align: upper-center; -unity-font-style: italic;" />
                    <ui:VisualElement name="Details" style="flex-grow: 1; display: none;">
                        <ui:Label text="Template TItle" name="Title" class="viewerTitle" style="display: flex; white-space: normal;" />
                        <ui:Label text="This is some sample text about our solar system!" name="Description" class="viewerDescription" style="height: auto; display: flex;" />
                        <ui:VisualElement name="Footer" class="footer" style="flex-grow: 1; flex-basis: 5%; display: flex; max-height: 10%; margin-top: 5px;">
                            <ui:Button text="Select" name="Select" />
                            <ui:Button text="Delete" name="Delete" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
